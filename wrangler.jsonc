{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "youtube-subscribe-notification",
	"main": "src/index.ts",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-08-19",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"TWITCH_CLIENT_ID": "y30s5stqxlakvgifylu8zkifibequf"
	},
	"kv_namespaces": [
		{
			"binding": "YT_SUBS",
			"id": "2e02e12b66034485a73149285a9f7deb"
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "YOUTUBE_DATA_API_KEY",
			"store_id": "dd5dbc2750ac41b393d0e79928aae64a",
			"secret_name": "YOUTUBE_DATA_API_KEY"
		},
		{
			"binding": "TWITCH_CLIENT_SECRET",
			"store_id": "dd5dbc2750ac41b393d0e79928aae64a",
			"secret_name": "TWITCH_CLIENT_SECRET"
		},
		{
			"binding": "TWITCH_EVENTSUB_SECRET",
			"store_id": "dd5dbc2750ac41b393d0e79928aae64a",
			"secret_name": "TWITCH_EVENTSUB_SECRET"
		}
	],
	"triggers": {
		"crons": ["0 */3 * * *", "* * * * *"]
	},
	"routes": [
		{
			"custom_domain": true,
			"pattern": "yt.obi1.dev"
		}
	],
	"observability": {
		"enabled": true
	}
}
