{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "youtube-subscribe-notification",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-19",
	"compatibility_flags": ["nodejs_compat"],
	"kv_namespaces": [
		{
			"binding": "YT_SUBS",
			"id": "2e02e12b66034485a73149285a9f7deb"
		}
	],
	"triggers": {
		"crons": ["0 */3 * * *"]
	},
	"routes": [
		{
			"custom_domain": true,
			"pattern": "yt.obi1.dev"
		}
	],
	"observability": {
		"enabled": true
	}
}
